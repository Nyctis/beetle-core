# The Solana Foundation's payment-channels program, for inference.
: "${BEETLE_CHANNEL_PROGRAM=CHNLxYvVA28MJP9PrFuDXccuoGXAx7jBacfLEkahyGsX}"
: "${BEETLE_CHANNEL_TREASURY=Cs2zdfUNonRdRGsiZUQQLdTxzxVvJZmgiX2mpLYKuEqP}"
