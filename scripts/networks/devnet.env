# Solana devnet. Point BEETLE_RPC_URL at your own endpoint if you have one.
: "${BEETLE_RPC_URL:=https://api.devnet.solana.com}"
# BEETLE_MINT empty: create a worthless test-USDC.
: "${BEETLE_MINT:=}"
# The payment-channels program has the same address on devnet. Its treasury owner
# there isn't published: this is the value compiled into the deployed binary, read
# from the chain by comparing it with the mainnet build.
: "${BEETLE_CHANNEL_PROGRAM=CHNLxYvVA28MJP9PrFuDXccuoGXAx7jBacfLEkahyGsX}"
: "${BEETLE_CHANNEL_TREASURY=4zTeC5mVqWLruDexgU2mV66p9t5vCA9JyiZqdGDUspap}"
