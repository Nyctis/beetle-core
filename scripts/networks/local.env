# A solana-test-validator started by setup_chain.sh. The ports are the defaults
# of this file, not of Solana: gossip's usual 8000 is often taken by something
# else. Set any BEETLE_* variable in your environment to override it.
: "${BEETLE_RPC_PORT:=8899}"
: "${BEETLE_FAUCET_PORT:=9900}"
: "${BEETLE_GOSSIP_PORT:=18000}"
: "${BEETLE_DYNAMIC_PORTS:=18001-18040}"
: "${BEETLE_RPC_URL:=http://127.0.0.1:$BEETLE_RPC_PORT}"
# BEETLE_MINT empty: create a worthless test-USDC.
: "${BEETLE_MINT:=}"
# The Solana Foundation's payment-channels program, for inference. It's copied
# read-only from BEETLE_CHANNEL_SOURCE_RPC into the local validator. Leave
# BEETLE_CHANNEL_PROGRAM empty to run without inference.
: "${BEETLE_CHANNEL_PROGRAM=CHNLxYvVA28MJP9PrFuDXccuoGXAx7jBacfLEkahyGsX}"
: "${BEETLE_CHANNEL_TREASURY=Cs2zdfUNonRdRGsiZUQQLdTxzxVvJZmgiX2mpLYKuEqP}"
: "${BEETLE_CHANNEL_SOURCE_RPC:=https://api.mainnet-beta.solana.com}"
